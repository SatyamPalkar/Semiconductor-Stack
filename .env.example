# Deliberate local-only example credentials. Never use for public hosting.
DATABASE_URL=postgresql+psycopg://semi:local-only-change-me@127.0.0.1:55432/semiconductor
LLM_PROVIDER=groq
# Choose a currently available Groq model before enabling live requests.
LLM_MODEL=
GROQ_API_KEY=
ENABLE_LIVE_LLM=false
# Required before adding SEC API ingestion. The pilot uses NVIDIA IR instead.
SEC_USER_AGENT=
# Public local API origin only; never put a credential in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8100
